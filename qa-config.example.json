{
  "$schema": "./schemas/qa-config.schema.json",
  "project": {
    "name": "petstore-example"
  },
  "api": {
    "default_environment": "local",
    "environments": {
      "local": {
        "packs": {
          "petstore": {
            "base_url": "http://localhost:8080/api/v3",
            "spec_url": "http://localhost:8080/api/v3/openapi.json",
            "allow_writes": true,
            "recovery": { "command": "docker compose restart petstore" },
            "auth": { "type": "api_key", "in": "header", "name": "api_key", "env": "API_KEY" }
          },
          "vampi": {
            "base_url": "http://localhost:5001",
            "spec_url": "http://localhost:5001/openapi.json",
            "allow_writes": true,
            "auth": {
              "type": "login",
              "path": "users/v1/login",
              "username_env": "VAMPI_USER_A_NAME",
              "password_env": "VAMPI_USER_A_PASSWORD"
            },
            "actors": {
              "user-a": {
                "type": "login",
                "path": "users/v1/login",
                "username_env": "VAMPI_USER_A_NAME",
                "password_env": "VAMPI_USER_A_PASSWORD"
              },
              "user-b": {
                "type": "login",
                "path": "users/v1/login",
                "username_env": "VAMPI_USER_B_NAME",
                "password_env": "VAMPI_USER_B_PASSWORD"
              }
            }
          },
          "keycloak": {
            "base_url": "http://localhost:8180",
            "spec_url": "https://www.keycloak.org/docs-api/26.7.5/rest-api/openapi.json",
            "allow_writes": true,
            "recovery": { "command": "docker compose restart keycloak", "ready_timeout_s": 120 },
            "auth": {
              "type": "oauth2_client_credentials",
              "token_url": "http://localhost:8180/realms/qa/protocol/openid-connect/token",
              "client_id_env": "KEYCLOAK_ADMIN_CLIENT_ID",
              "client_secret_env": "KEYCLOAK_ADMIN_CLIENT_SECRET"
            },
            "actors": {
              "admin": {
                "type": "oauth2_client_credentials",
                "token_url": "http://localhost:8180/realms/qa/protocol/openid-connect/token",
                "client_id_env": "KEYCLOAK_ADMIN_CLIENT_ID",
                "client_secret_env": "KEYCLOAK_ADMIN_CLIENT_SECRET"
              },
              "viewer": {
                "type": "oauth2_client_credentials",
                "token_url": "http://localhost:8180/realms/qa/protocol/openid-connect/token",
                "client_id_env": "KEYCLOAK_VIEWER_CLIENT_ID",
                "client_secret_env": "KEYCLOAK_VIEWER_CLIENT_SECRET"
              },
              "no-role": {
                "type": "oauth2_client_credentials",
                "token_url": "http://localhost:8180/realms/qa/protocol/openid-connect/token",
                "client_id_env": "KEYCLOAK_NO_ROLE_CLIENT_ID",
                "client_secret_env": "KEYCLOAK_NO_ROLE_CLIENT_SECRET"
              }
            }
          }
        }
      },
      "local-vulnerable": {
        "packs": {
          "vampi": {
            "base_url": "http://localhost:5002",
            "spec_url": "http://localhost:5002/openapi.json",
            "allow_writes": true,
            "auth": {
              "type": "login",
              "path": "users/v1/login",
              "username_env": "VAMPI_USER_A_NAME",
              "password_env": "VAMPI_USER_A_PASSWORD"
            },
            "actors": {
              "user-a": {
                "type": "login",
                "path": "users/v1/login",
                "username_env": "VAMPI_USER_A_NAME",
                "password_env": "VAMPI_USER_A_PASSWORD"
              },
              "user-b": {
                "type": "login",
                "path": "users/v1/login",
                "username_env": "VAMPI_USER_B_NAME",
                "password_env": "VAMPI_USER_B_PASSWORD"
              }
            }
          }
        }
      },
      "reference": {
        "packs": {
          "petstore": {
            "base_url": "http://localhost:8081/api/v3",
            "spec_url": "http://localhost:8081/api/v3/openapi.json",
            "allow_writes": false,
            "auth": { "type": "api_key", "in": "header", "name": "api_key", "env": "API_KEY" }
          }
        }
      },
      "public": {
        "packs": {
          "petstore": {
            "base_url": "https://petstore3.swagger.io/api/v3",
            "spec_url": "https://petstore3.swagger.io/api/v3/openapi.json",
            "allow_writes": false,
            "auth": { "type": "api_key", "in": "header", "name": "api_key", "env": "API_KEY" }
          }
        }
      }
    }
  },
  "test_management": {
    "provider": "local",
    "options": { "dir": "reports/tm/local" }
  },
  "tracker": {
    "provider": "local",
    "options": { "dir": "docs/tracker/local" },
    "key_pattern": "LOCAL-\\d+",
    "base_url": null,
    "issue_url": "docs/tracker/local/issues.json#{key}"
  },
  "policies": {
    "commit": {
      "require_tracker_key": false,
      "max_tracker_keys": 1,
      "conventional_commits": true,
      "protected_branches": ["main"]
    },
    "pull_request": {
      "required_labels": []
    }
  },
  "quality_gate": {
    "pass_rate": {
      "format": "allure-results",
      "source": "allure-results",
      "fail_below_pct": 90,
      "review_below_pct": 100
    },
    "p95_latency": {
      "format": "k6-summary",
      "source": "reports/perf/petstore.json",
      "fail_above_ms": 500,
      "review_above_ms": 200,
      "min_samples": 100
    },
    "dast": {
      "source": "reports/dast/vampi.json",
      "fail_above": { "high": 0, "medium": 0 },
      "review_above": { "low": 5 }
    }
  }
}
