{
  "swagger": "2.0",
  "info": { "title": "Shelter", "version": "1.0.0" },
  "host": "api.example.test",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "apiKey": { "type": "apiKey", "in": "header", "name": "X-Api-Key" }
  },
  "security": [{ "apiKey": [] }],
  "paths": {
    "/animals": {
      "post": {
        "operationId": "createAnimal",
        "summary": "Register an animal",
        "tags": ["animals"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Animal" }
          }
        ],
        "responses": {
          "201": { "description": "Created", "schema": { "$ref": "#/definitions/Animal" } },
          "400": { "description": "Invalid input", "schema": { "$ref": "#/definitions/Error" } }
        }
      }
    },
    "/animals/{animalId}": {
      "get": {
        "operationId": "getAnimal",
        "summary": "Read an animal",
        "tags": ["animals"],
        "security": [],
        "parameters": [
          {
            "name": "animalId",
            "in": "path",
            "required": true,
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          {
            "name": "verbose",
            "in": "query",
            "required": false,
            "type": "boolean",
            "default": false
          }
        ],
        "responses": {
          "200": { "description": "Found", "schema": { "$ref": "#/definitions/Animal" } },
          "404": { "description": "Not found" }
        }
      }
    }
  },
  "definitions": {
    "Animal": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "integer", "format": "int64", "readOnly": true },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[A-Za-z ]+$",
          "example": "Rex"
        },
        "weight": { "type": "number", "minimum": 0, "exclusiveMinimum": true },
        "nickname": { "type": "string", "x-nullable": true },
        "status": { "type": "string", "enum": ["active", "adopted"] },
        "tags": { "type": "array", "items": { "$ref": "#/definitions/Tag" } }
      }
    },
    "Tag": {
      "type": "object",
      "properties": { "label": { "type": "string" } }
    },
    "Error": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "integer", "format": "int32" },
        "message": { "type": "string" }
      }
    }
  }
}
