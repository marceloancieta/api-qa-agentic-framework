{
  "realm": "qa",
  "enabled": true,
  "accessTokenLifespan": 60,
  "clients": [
    {
      "clientId": "${KEYCLOAK_ADMIN_CLIENT_ID:qa-admin}",
      "name": "QA admin: manages users and groups",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "${KEYCLOAK_VIEWER_CLIENT_ID:qa-viewer}",
      "name": "QA viewer: reads users and groups",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_VIEWER_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "${KEYCLOAK_NO_ROLE_CLIENT_ID:qa-no-role}",
      "name": "QA no role: no admin permission",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_NO_ROLE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-qa-admin",
      "enabled": true,
      "serviceAccountClientId": "${KEYCLOAK_ADMIN_CLIENT_ID:qa-admin}",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "view-users",
          "query-users",
          "manage-users",
          "query-groups"
        ]
      }
    },
    {
      "username": "service-account-qa-viewer",
      "enabled": true,
      "serviceAccountClientId": "${KEYCLOAK_VIEWER_CLIENT_ID:qa-viewer}",
      "clientRoles": {
        "realm-management": ["view-realm", "view-users", "query-users", "query-groups"]
      }
    },
    {
      "username": "service-account-qa-no-role",
      "enabled": true,
      "serviceAccountClientId": "${KEYCLOAK_NO_ROLE_CLIENT_ID:qa-no-role}"
    }
  ]
}
