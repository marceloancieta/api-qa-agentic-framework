{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marceloancieta/api-qa-agentic-framework/schemas/qa-config.schema.json",
  "title": "qa-config",
  "description": "Per-project configuration of the API QA framework. Copy qa-config.example.json to qa-config.json (git-ignored) and adjust. Secrets never go here: they live in .env and are referenced by variable name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "api", "test_management"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_environment", "environments"],
      "properties": {
        "default_environment": {
          "type": "string",
          "minLength": 1
        },
        "environments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/environment"
          }
        }
      }
    },
    "test_management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {
          "description": "Adapter under scripts/tm/adapters/<provider>.",
          "enum": ["allure-report", "local", "allure-testops", "testrail"]
        },
        "options": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["provider"],
            "properties": { "provider": { "const": "allure-testops" } }
          },
          "then": {
            "type": "object",
            "properties": {
              "options": {
                "type": "object",
                "description": "Every option falls back to an environment variable: ALLURE_ENDPOINT, ALLURE_PROJECT_ID, and the token in ALLURE_TOKEN.",
                "additionalProperties": false,
                "properties": {
                  "endpoint": { "type": "string", "format": "uri" },
                  "project_id": { "type": "integer", "minimum": 1 },
                  "token_env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                  "resultsDir": { "type": "string" },
                  "wait_seconds": { "type": "integer", "minimum": 0 },
                  "poll_ms": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "description": "Adapter under scripts/tracker/adapters/<provider>; none disables every tracker call.",
          "enum": ["none", "local", "github", "jira"],
          "default": "none"
        },
        "options": {
          "description": "Provider options. github: repo \"owner/name\", token_env (default GITHUB_TOKEN). jira: project key, issue_type, user_env (default JIRA_USER), token_env (default JIRA_TOKEN); uses base_url. local: dir.",
          "type": "object"
        },
        "key_pattern": {
          "description": "Regex (JavaScript syntax) of an issue key, e.g. \"PROJ-\\d+\". null disables every tracker-key rule.",
          "type": ["string", "null"]
        },
        "base_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "issue_url": {
          "description": "Link to one issue, with {key} where the key goes, e.g. \"https://tracker.example/browse/{key}\". Used by knownGap().",
          "type": ["string", "null"],
          "pattern": "\\{key\\}"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "github"
              }
            },
            "required": ["provider"],
            "type": "object"
          },
          "then": {
            "required": ["options"],
            "properties": {
              "options": {
                "required": ["repo"],
                "properties": {
                  "repo": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "jira"
              }
            },
            "required": ["provider"],
            "type": "object"
          },
          "then": {
            "required": ["options", "base_url"],
            "properties": {
              "base_url": {
                "type": "string",
                "format": "uri"
              },
              "options": {
                "required": ["project"],
                "properties": {
                  "project": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9]+$"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_tracker_key": {
              "type": "boolean",
              "default": false
            },
            "max_tracker_keys": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "conventional_commits": {
              "type": "boolean",
              "default": false
            },
            "protected_branches": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required_labels": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        }
      }
    },
    "quality_gate": {
      "description": "Thresholds of scripts/quality-gate.mjs. Every check is optional: an absent check is not evaluated, and a configured check whose source is missing is reported as SKIPPED (or FAIL when required). Each check yields PASS, REVIEW (publish the artifact, keep the build green) or FAIL.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pass_rate": {
          "description": "Share of executed tests that passed, in percent. Skipped tests are not executed; a flaky test (failed, then passed on retry) counts as passed and is listed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["fail_below_pct"],
          "properties": {
            "format": {
              "description": "playwright-json: the JSON report written through QA_JSON_REPORT. allure-results: the *-result.json files of a results directory.",
              "enum": ["playwright-json", "allure-results"],
              "default": "playwright-json"
            },
            "source": {
              "description": "Report file (playwright-json) or results directory (allure-results). Defaults: $QA_JSON_REPORT, or allure-results.",
              "type": "string",
              "minLength": 1
            },
            "fail_below_pct": {
              "$ref": "#/$defs/percent"
            },
            "review_below_pct": {
              "$ref": "#/$defs/percent"
            },
            "required": {
              "$ref": "#/$defs/gateRequired"
            }
          }
        },
        "p95_latency": {
          "description": "95th percentile of API case durations (Allure start/stop) in milliseconds. Per test case, not per request, until evidence attachments carry request timings.",
          "type": "object",
          "additionalProperties": false,
          "required": ["fail_above_ms"],
          "properties": {
            "source": {
              "description": "Allure results directory. Default: allure-results.",
              "type": "string",
              "minLength": 1
            },
            "fail_above_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "review_above_ms": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_samples": {
              "description": "Fewer timed API cases than this make the check SKIPPED: a percentile of a handful of timings is noise.",
              "type": "integer",
              "minimum": 1,
              "default": 5
            },
            "required": {
              "$ref": "#/$defs/gateRequired"
            }
          }
        },
        "dast": {
          "description": "Alerts of a ZAP-style JSON report (site[].alerts[] with riskcode 0-3), counted per risk level. A threshold is the largest count still allowed.",
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "fail_above"],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "fail_above": {
              "$ref": "#/$defs/riskCounts"
            },
            "review_above": {
              "$ref": "#/$defs/riskCounts"
            },
            "required": {
              "$ref": "#/$defs/gateRequired"
            }
          }
        },
        "mutation_score": {
          "description": "Stryker mutation score in percent: detected (killed, timeout) over valid mutants (detected plus survived and no coverage).",
          "type": "object",
          "additionalProperties": false,
          "required": ["fail_below_pct"],
          "properties": {
            "source": {
              "description": "Stryker JSON report. Default: reports/mutation/mutation.json.",
              "type": "string",
              "minLength": 1
            },
            "fail_below_pct": {
              "$ref": "#/$defs/percent"
            },
            "review_below_pct": {
              "$ref": "#/$defs/percent"
            },
            "required": {
              "$ref": "#/$defs/gateRequired"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "gateRequired": {
      "description": "true turns a missing source into FAIL instead of SKIPPED.",
      "type": "boolean",
      "default": false
    },
    "riskCounts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "informational": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "environment": {
      "description": "A named place to run, holding one entry per service pack it serves. A pack without an entry here cannot run in this environment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packs"],
      "properties": {
        "packs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "description": "The pack's folder name under services/.",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/pack"
          }
        }
      }
    },
    "pack": {
      "description": "Where one service pack runs in one environment and how it authenticates. QA_<PACK>_BASE_URL and QA_<PACK>_SPEC_URL override base_url and spec_url for one run (pack name upper-cased, hyphens as underscores).",
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "auth"],
      "properties": {
        "auth": {
          "description": "The credential of the built-in \"default\" actor.",
          "$ref": "#/$defs/auth"
        },
        "actors": {
          "description": "Extra named credentials for actor(name). \"default\" is this pack's auth and \"anonymous\" sends no credentials; both are built in.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "not": {
              "enum": ["default", "anonymous"]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/auth"
          }
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "spec_url": {
          "type": "string",
          "format": "uri"
        },
        "allow_writes": {
          "description": "false marks a shared/public environment: write tests must skip there.",
          "type": "boolean",
          "default": false
        },
        "recovery": {
          "description": "How the destructive lane brings the service back after each @destructive case: a shell command (for a local container, a restart) and how long to wait for the API to answer again.",
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "ready_timeout_s": {
              "type": "integer",
              "minimum": 1,
              "default": 60
            }
          }
        }
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "in", "name", "env"],
          "properties": {
            "type": {
              "const": "api_key"
            },
            "in": {
              "enum": ["header", "query"]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "env": {
              "$ref": "#/$defs/envVar"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "env"],
          "properties": {
            "type": {
              "const": "bearer"
            },
            "env": {
              "$ref": "#/$defs/envVar"
            }
          }
        }
      ]
    },
    "envVar": {
      "description": "Name of the environment variable that holds the secret (never the secret itself).",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    }
  }
}
