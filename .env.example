# Environment template. Copy to .env and fill in. NEVER commit .env or put real values here.

# Which qa-config environment to target (overrides api.default_environment).
QA_ENV=local

# Optional: override the environment's base_url for a one-off run.
API_BASE_URL=

# Secret named by qa-config api.auth.env. The example Petstore accepts any value; use a real key
# only for a real API.
API_KEY=

# Optional runner switches (see playwright.config.ts).
# QA_RETRIES=0                      # retries per case; gate lanes keep 0
# QA_JSON_REPORT=results.json       # adds a JSON report; never use --reporter
# QA_JUNIT_REPORT=junit.xml         # adds a JUnit report
