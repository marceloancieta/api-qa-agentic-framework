# Environment template. Copy to .env and fill in. NEVER commit .env or put real values here.

# Which qa-config environment to target (overrides api.default_environment).
QA_ENV=local

# Optional: override one pack's base_url and spec_url for a one-off run. The name is
# QA_<PACK>_BASE_URL / QA_<PACK>_SPEC_URL, pack upper-cased and hyphens as underscores.
QA_PETSTORE_BASE_URL=
# QA_PETSTORE_SPEC_URL=

# Secret named by each pack's auth.env in qa-config (api.environments.<env>.packs.<pack>), plus
# one per extra actor in that pack's actors. The example Petstore accepts any value; use a real
# key only for a real API.
API_KEY=

# VAmPI pack (services/vampi, `login` auth): the users behind actors user-a (also the default) and
# user-b. The pack registers them on its first run against a fresh container; any values work.
VAMPI_USER_A_NAME=
VAMPI_USER_A_PASSWORD=
VAMPI_USER_B_NAME=
VAMPI_USER_B_PASSWORD=

# Keycloak pack (services/keycloak, `oauth2_client_credentials` auth): the service-account clients
# of the local realm, behind actors admin (also the default), viewer and no-role. `npm run
# keycloak:up` imports them with these secrets; any values work for the local container.
KEYCLOAK_ADMIN_CLIENT_ID=qa-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_VIEWER_CLIENT_ID=qa-viewer
KEYCLOAK_VIEWER_CLIENT_SECRET=
KEYCLOAK_NO_ROLE_CLIENT_ID=qa-no-role
KEYCLOAK_NO_ROLE_CLIENT_SECRET=

# Test management: QA_TM_PROVIDER replaces test_management.provider for one run.
# QA_TM_PROVIDER=allure-testops
# Only for the "allure-testops" provider (docs/test-management.md):
# ALLURE_ENDPOINT=https://<instance>.testops.cloud
# ALLURE_PROJECT_ID=
# ALLURE_TOKEN=                     # an API token from your TestOps profile; never commit or paste it

# Issue trackers: only for tracker.provider "github" or "jira" (docs/test-management.md). The
# names are the defaults; tracker.options can name other variables.
# GITHUB_TOKEN=                     # a token that can read and write issues of tracker.options.repo
# JIRA_USER=
# JIRA_TOKEN=

# Optional runner switches (see playwright.config.ts).
# QA_RETRIES=0                      # retries per case; gate lanes keep 0
# QA_JSON_REPORT=results.json       # adds a JSON report; never use --reporter
# QA_JUNIT_REPORT=junit.xml         # adds a JUnit report (lanes:destructive writes one per case)
# QA_SEED=123456                    # replays the test data of an earlier run (printed at start)
# QA_CLOCK=2026-01-01T00:00:00Z     # pins "now" for builders and the faker
# QA_ALLOW_CONCURRENT_RUNS=1        # run although another local run holds allure-results.lock
# QA_TRACE=retain-on-failure        # off | on | retain-on-failure; off keeps credentials out of traces
# QA_KEEP_RESULTS=1                 # keep allure-results of the run before (destructive lane, Jenkins)
# QA_RUN_ID=<id>                    # run id in results and tool logs; CI sets it, otherwise one is made
# QA_LOG_FORMAT=json                # tool logs as one JSON object per line

# Host ports of the local containers; docker compose reads them from this file. When you move one,
# point the pack at it with QA_<PACK>_BASE_URL and QA_<PACK>_SPEC_URL.
# PETSTORE_PORT=8080
# PETSTORE_REFERENCE_PORT=8081
# VAMPI_SECURE_PORT=5001
# VAMPI_VULNERABLE_PORT=5002
# KEYCLOAK_PORT=8180

# Live auth check (npm run auth:live): replaces the public OAuth mock the oauth2 check calls.
# QA_OAUTH2_LIVE_TOKEN_URL=https://<token-server>/token
