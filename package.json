{
  "name": "api-qa-agentic-framework",
  "version": "0.0.0",
  "description": "Agentic API QA framework: OpenAPI-driven test design, Playwright + TypeScript execution, pluggable test-management adapters, Claude Code skills and guardrails.",
  "license": "Apache-2.0",
  "author": "Marcelo Ancieta",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "node scripts/config-check.mjs --all",
    "test:hooks": "node --test \".claude/hooks/__tests__/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/__tests__/*.test.mjs\"",
    "test:unit": "playwright test --project=unit",
    "types:check": "tsc -p .",
    "scan:denylist": "node scripts/scan-denylist.mjs --tracked",
    "scan:denylist:history": "node scripts/scan-denylist.mjs --history",
    "scan:denylist:self-test": "node scripts/scan-denylist.mjs --self-test",
    "scan:secrets": "node scripts/secret-scan.mjs --history",
    "hooks:install": "git config core.hooksPath .githooks",
    "petstore:up": "docker compose up -d --wait petstore",
    "petstore:down": "docker compose down",
    "contract:digest": "node scripts/swagger-digest.mjs --write",
    "contract:digest:check": "node scripts/swagger-digest.mjs --check",
    "contract:digest:live": "node scripts/swagger-digest.mjs --live --check",
    "contract:probes": "node scripts/derive-probe-matrix.mjs",
    "contract:probes:write": "node scripts/derive-probe-matrix.mjs --write",
    "contract:probes:check": "node scripts/derive-probe-matrix.mjs --check",
    "contract:value-sets": "node scripts/derive-value-sets.mjs --write",
    "contract:value-sets:check": "node scripts/derive-value-sets.mjs --check",
    "contract:floor": "node scripts/derive-floor.mjs",
    "contract:codes": "node scripts/declared-codes.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "scaffold:service": "node scripts/scaffold-service.mjs",
    "lint:harness": "node scripts/lint-harness.mjs",
    "lint:suite": "node scripts/lint-suite.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint:self-test": "node scripts/lint-harness.mjs --self-test && node scripts/lint-suite.mjs --self-test && node scripts/lint-docs.mjs --self-test",
    "lint:qa": "npm run lint:harness && npm run lint:suite && npm run lint:docs && npm run lint:self-test",
    "coverage:status": "node scripts/coverage-status.mjs",
    "traceability": "node scripts/traceability.mjs",
    "traceability:write": "node scripts/traceability.mjs --write",
    "lanes:known-gap": "node scripts/known-gap-lane.mjs",
    "lanes:published": "node scripts/published-lane.mjs",
    "lanes:published:changed": "node scripts/published-lane.mjs --changed-from-digest",
    "lanes:flake": "node scripts/flake-lane.mjs --quarantine-report",
    "quality:gate": "node scripts/quality-gate.mjs --summary reports/quality-gate.md",
    "mutation": "stryker run",
    "tm:manifest": "node scripts/tm/manifest.mjs",
    "tm:publish": "node scripts/tm/run.mjs publish",
    "tm:report": "node scripts/tm/run.mjs report",
    "tm:contract:live": "node --test \"scripts/__live__/*.test.mjs\"",
    "test": "playwright test",
    "test:smoke": "playwright test --project=api --grep @smoke",
    "gates": "npm run lint && npm run format:check && npm run types:check && npm run config:check && npm run test:hooks && npm run test:scripts && npm run contract:check && npm run lint:qa && npm run coverage:status && npm run test:unit && npm run scan:denylist:self-test",
    "tm:open": "allure open reports/allure-report",
    "tracker": "node scripts/tracker/cli.mjs",
    "cited:status": "node scripts/cited-status.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^22.20.5",
    "allure": "^3.18.0",
    "allure-js-commons": "^3.12.2",
    "allure-playwright": "^3.12.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  }
}
