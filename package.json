{
  "name": "api-qa-agentic-framework",
  "version": "0.0.0",
  "description": "Agentic API QA framework: OpenAPI-driven test design, Playwright + TypeScript execution, pluggable test-management adapters, Claude Code skills and guardrails.",
  "license": "Apache-2.0",
  "author": "Marcelo Ancieta",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "node scripts/config-check.mjs --all",
    "test:hooks": "node --test \".claude/hooks/__tests__/*.test.mjs\"",
    "scan:denylist": "node scripts/scan-denylist.mjs --tracked",
    "scan:denylist:history": "node scripts/scan-denylist.mjs --history",
    "scan:denylist:self-test": "node scripts/scan-denylist.mjs --self-test",
    "scan:secrets": "node scripts/secret-scan.mjs --history",
    "hooks:install": "git config core.hooksPath .githooks",
    "petstore:up": "docker compose up -d --wait petstore",
    "petstore:down": "docker compose down",
    "gates": "npm run lint && npm run format:check && npm run config:check && npm run test:hooks && npm run scan:denylist:self-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
